# Pelligavi — conexão com o PostgreSQL
# Copie este arquivo para .env e ajuste o que for preciso. O start.sh lê daqui.

# --- banco ---------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=troque-esta-senha
PGDATABASE=pelligavi

# --- aplicação -----------------------------------------------------------
# porta do site e da API (as duas coisas saem do mesmo processo)
PORT=8888

# segredo dos tokens de sessão do painel — troque em produção
JWT_SECRET=troque-este-segredo
JWT_HORAS=8

# 1 = o código de verificação do login aparece na tela (só para demonstração)
OTP_MOCK=1
