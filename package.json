{
  "name": "pelligavi-demo",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Pelligavi: sistema de gestão para pizzaria — API Express 5 + PostgreSQL e front React 19 (Vite)",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && npm --prefix web run build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "serve": "node dist-server/bootstrap/server.js",
    "build:server": "tsc -p tsconfig.server.json",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
