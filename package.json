{
  "name": "pelligavi-demo",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Demo Pelligavi em TypeScript (sem framework, sem bundler): tsc compila src/ para dist/",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && node scripts/copiar-vendor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "watch": "tsc -p tsconfig.json --watch",
    "serve": "node dist-server/bootstrap/server.js",
    "build:server": "tsc -p tsconfig.server.json",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
